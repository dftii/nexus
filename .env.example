# Copy to .env and adjust. Never commit .env (it is gitignored).
# Everything below is a development-only placeholder, not a real secret.

# --- Local PostgreSQL (docker-compose.yml reads these) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
# Host port for the container. Change it (e.g. 5433) if 5432 is already taken.
POSTGRES_PORT=5432

# Must match the four values above.
DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5432/nexus?schema=public"

# --- Authentication (Auth.js v5 + Discord OAuth2, Phase 2) ---
# All optional for build and tests; without them /login says sign-in is not
# configured. Create the application at https://discord.com/developers/applications
# and add this redirect URI: http://localhost:3000/api/auth/callback/discord
# Session signing secret. Generate one with: npx auth secret
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# `next dev` trusts localhost on its own. `next start` (production mode) needs
# the public URL or AUTH_TRUST_HOST=true, even on localhost, or Auth.js answers
# "UntrustedHost".
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true
# If TLS to discord.com fails with SELF_SIGNED_CERT_IN_CHAIN (antivirus or proxy
# re-signing HTTPS), point Node at the intercepting root CA. Never disable
# certificate verification. See README, Troubleshooting.
# NODE_EXTRA_CA_CERTS=/path/to/root-ca.pem

# --- Discord bot (Phase 3, a separate process: npm run bot:dev) ---
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# Never commit it. Only the bot process reads it; the web app does not.
DISCORD_BOT_TOKEN=
# Comma-separated server IDs the bot is allowed to process (Discord: User
# Settings -> Advanced -> Developer Mode, then right-click the server -> Copy
# Server ID). REQUIRED for the bot to store anything: when empty or missing the
# bot only logs in and processes no community (fail closed). Example:
# DISCORD_GUILD_ALLOWLIST=123456789012345678,234567890123456789
DISCORD_GUILD_ALLOWLIST=
# Heartbeat interval in ms (5000-120000). The web shows the bot as offline when
# the last heartbeat is older than 3 minutes.
# BOT_HEARTBEAT_INTERVAL_MS=60000

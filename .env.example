# Copy to .env and adjust. Never commit .env (it is gitignored).
# Everything below is a development-only placeholder, not a real secret.

# --- Local PostgreSQL (docker-compose.yml reads these) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus

# Must match the three values above (host port 5432).
DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5432/nexus?schema=public"


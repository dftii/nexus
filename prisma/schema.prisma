// NEXUS data model.
//
// Phase 1: who a user is, which Discord server (community) they manage and what
// role they hold in it. Phase 2 adds the Auth.js tables (Account, Session) and
// the fields community selection needs. Analytics, automations and moderation
// tables arrive in later phases, driven by real requirements
// (see docs/PROJECT_PLAN.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER

  @@map("community_role")
}

/// A person who signs in to NEXUS through Discord.
model User {
  id          String   @id @default(cuid())
  discordId   String   @unique @map("discord_id")
  username    String
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  email       String?  @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Fields the Auth.js Prisma adapter reads and writes. `name` / `image` mirror
  // displayName / avatarUrl; `emailVerified` stays null (no email scope, no
  // email provider).
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")

  accounts         Account[]
  sessions         Session[]
  ownedCommunities Community[]
  memberships      CommunityMembership[]

  @@map("users")
}

/// A Discord server (guild) registered in NEXUS.
model Community {
  id                        String    @id @default(cuid())
  discordGuildId            String    @unique @map("discord_guild_id")
  name                      String
  iconUrl                   String?   @map("icon_url")
  /// The NEXUS user who is the Discord owner of the guild, when known.
  ownerId                   String?   @map("owner_id")
  /// First time the Gateway confirmed the NEXUS bot is present in the guild for
  /// the current installation (= when activity collection started). Set by the
  /// bot process only; cleared when the bot is removed from the guild. Null =
  /// not installed.
  botConnectedAt            DateTime? @map("bot_connected_at")
  /// Last bot heartbeat that included this guild. Its freshness decides
  /// online/offline (see src/lib/bot-status.ts).
  botLastSeenAt             DateTime? @map("bot_last_seen_at")
  /// Phase 4 watermark: every UTC day up to and including this date has a
  /// durable daily aggregate, and the dashboard reads those days from the
  /// aggregate tables only. Days after it are read from raw `message_events`.
  /// Null = nothing finalized yet (everything comes from raw events).
  analyticsFinalizedThrough DateTime? @map("analytics_finalized_through") @db.Date
  /// Last successful aggregation run for this community (bot process).
  analyticsAggregatedAt     DateTime? @map("analytics_aggregated_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  owner           User?                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships     CommunityMembership[]
  messageEvents   MessageEvent[]
  dailyActivity   CommunityDailyActivity[]
  channelActivity ChannelDailyActivity[]
  channels        DiscordChannel[]

  @@index([ownerId])
  @@map("communities")
}

/// Links a user to a community with a role.
model CommunityMembership {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  communityId    String        @map("community_id")
  role           CommunityRole @default(MEMBER)
  joinedAt       DateTime      @default(now()) @map("joined_at")
  /// Last time Discord confirmed the user still manages the guild.
  lastVerifiedAt DateTime?     @map("last_verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("community_memberships")
}

/// An OAuth account linked to a user (Auth.js adapter model). Holds the
/// Discord tokens; they are read only by server code and never sent to the
/// browser.
model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A database-backed login session (Auth.js adapter model).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One message observed by the bot (Phase 3). Metadata only: who, where, when.
/// The message content, embeds, attachments and mentions are never read or
/// stored (data minimization). Rows are never deleted when the bot is removed;
/// the cascade only fires if a Community row is deleted, which is not a flow
/// of this phase.
model MessageEvent {
  id               String   @id @default(cuid())
  communityId      String   @map("community_id")
  /// Discord snowflake of the message; unique so Gateway resends are idempotent.
  discordMessageId String   @unique @map("discord_message_id")
  discordGuildId   String   @map("discord_guild_id")
  discordChannelId String   @map("discord_channel_id")
  authorDiscordId  String   @map("author_discord_id")
  /// When the message was created on Discord.
  occurredAt       DateTime @map("occurred_at")
  /// When NEXUS stored it.
  createdAt        DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, occurredAt])
  @@index([communityId, discordChannelId, occurredAt])
  @@map("message_events")
}

/// Phase 4: recorded messages of one community on one UTC calendar day,
/// computed from `message_events` by the bot's maintenance job. Counts only:
/// no author ids, no payloads. `authorCount` is distinct WITHIN that day; it
/// must never be summed to get distinct authors over a longer range. Rows are
/// kept indefinitely (raw-event retention does not apply to them).
model CommunityDailyActivity {
  communityId  String   @map("community_id")
  /// UTC calendar date (00:00:00Z to 23:59:59.999Z).
  day          DateTime @db.Date
  messageCount Int      @map("message_count")
  authorCount  Int      @map("author_count")
  aggregatedAt DateTime @map("aggregated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, day])
  @@map("community_daily_activity")
}

/// Phase 4: the same daily aggregate split by channel. For a given community
/// and day, `messageCount` over all its channels equals the community row.
model ChannelDailyActivity {
  communityId      String   @map("community_id")
  day              DateTime @db.Date
  discordChannelId String   @map("discord_channel_id")
  messageCount     Int      @map("message_count")
  authorCount      Int      @map("author_count")
  aggregatedAt     DateTime @map("aggregated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, day, discordChannelId])
  @@map("channel_daily_activity")
}

/// Phase 4: display metadata for channels (and threads) of allowlisted guilds,
/// maintained by the bot from the Guilds intent. Only labels: no permissions,
/// no topic, no message data. Missing rows fall back to the channel id.
model DiscordChannel {
  discordChannelId String    @id @map("discord_channel_id")
  communityId      String    @map("community_id")
  discordGuildId   String    @map("discord_guild_id")
  name             String
  /// discord.js `ChannelType` numeric value.
  type             Int
  /// Set when Discord reports the channel deleted; the label is kept so old
  /// analytics still read well.
  deletedAt        DateTime? @map("deleted_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@map("discord_channels")
}

// NEXUS data model.
//
// Phase 1: who a user is, which Discord server (community) they manage and what
// role they hold in it. Phase 2 adds the Auth.js tables (Account, Session) and
// the fields community selection needs. Analytics, automations and moderation
// tables arrive in later phases, driven by real requirements
// (see docs/PROJECT_PLAN.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER

  @@map("community_role")
}

/// A person who signs in to NEXUS through Discord.
model User {
  id          String   @id @default(cuid())
  discordId   String   @unique @map("discord_id")
  username    String
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  email       String?  @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Fields the Auth.js Prisma adapter reads and writes. `name` / `image` mirror
  // displayName / avatarUrl; `emailVerified` stays null (no email scope, no
  // email provider).
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")

  accounts         Account[]
  sessions         Session[]
  ownedCommunities Community[]
  memberships      CommunityMembership[]

  @@map("users")
}

/// A Discord server (guild) registered in NEXUS.
model Community {
  id             String    @id @default(cuid())
  discordGuildId String    @unique @map("discord_guild_id")
  name           String
  iconUrl        String?   @map("icon_url")
  /// The NEXUS user who is the Discord owner of the guild, when known.
  ownerId        String?   @map("owner_id")
  /// First time the Gateway confirmed the NEXUS bot is present in the guild for
  /// the current installation (= when activity collection started). Set by the
  /// bot process only; cleared when the bot is removed from the guild. Null =
  /// not installed.
  botConnectedAt DateTime? @map("bot_connected_at")
  /// Last bot heartbeat that included this guild. Its freshness decides
  /// online/offline (see src/lib/bot-status.ts).
  botLastSeenAt  DateTime? @map("bot_last_seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner         User?                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships   CommunityMembership[]
  messageEvents MessageEvent[]

  @@index([ownerId])
  @@map("communities")
}

/// Links a user to a community with a role.
model CommunityMembership {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  communityId    String        @map("community_id")
  role           CommunityRole @default(MEMBER)
  joinedAt       DateTime      @default(now()) @map("joined_at")
  /// Last time Discord confirmed the user still manages the guild.
  lastVerifiedAt DateTime?     @map("last_verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("community_memberships")
}

/// An OAuth account linked to a user (Auth.js adapter model). Holds the
/// Discord tokens; they are read only by server code and never sent to the
/// browser.
model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A database-backed login session (Auth.js adapter model).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One message observed by the bot (Phase 3). Metadata only: who, where, when.
/// The message content, embeds, attachments and mentions are never read or
/// stored (data minimization). Rows are never deleted when the bot is removed;
/// the cascade only fires if a Community row is deleted, which is not a flow
/// of this phase.
model MessageEvent {
  id               String   @id @default(cuid())
  communityId      String   @map("community_id")
  /// Discord snowflake of the message; unique so Gateway resends are idempotent.
  discordMessageId String   @unique @map("discord_message_id")
  discordGuildId   String   @map("discord_guild_id")
  discordChannelId String   @map("discord_channel_id")
  authorDiscordId  String   @map("author_discord_id")
  /// When the message was created on Discord.
  occurredAt       DateTime @map("occurred_at")
  /// When NEXUS stored it.
  createdAt        DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, occurredAt])
  @@index([communityId, discordChannelId, occurredAt])
  @@map("message_events")
}
